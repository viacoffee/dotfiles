# Make a directory and then cd to it
function mkcd() {
  mkdir -p $1 && cd $1
}

# Make a directory and move file to it
function mkmv() {
  mkdir -p $2 && mv $1 $2
}

# Open a Nautilus window without keeping it attached to this shell.
function open() {
  uwsm-app -- nautilus -w "$@" >/dev/null 2>&1 &!
}
