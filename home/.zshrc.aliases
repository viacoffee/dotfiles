# Stats
alias top='btop'
alias htop='btop'
alias ping='prettyping --nolegend'

# Vim
alias vim='nvim'

# Directory listings
alias l='lsd -a1'
alias la='lsd -la'
alias lr='lsd -R'
alias lra='lsd -RA'
alias lt='lsd --tree'

# Git
alias gs='git status'
alias gl='git log --oneline --graph --decorate'
alias gp='git pull'
alias gd='git diff'
alias gc='git commit'

# General
alias c='clear'

# Navigation
alias ...='cd ../..'
alias ....='cd ../../..'

# Agents
alias cc='claude'
alias oc='opencode'

# Quick open
## Firefox
alias ff='uwsm-app -- firefox --new-window'

# Tmux
t() {
  local s="$(basename $PWD)-$(echo $PWD | shasum -a 256 | cut -c1-4)"
  tmux has-session -t "$s" 2>/dev/null || tmux new-session -d -s "$s" -n vim \; send-keys -t "$s" vim Enter \; new-window -t "$s" \; select-window -t "$s":1
  tmux new-session -A -s "$s"
}
alias tl="tmux list-sessions -F '#{s/ [a-f0-9][a-f0-9][a-f0-9][a-f0-9]$//:session_name}' 2>/dev/null || echo 'no sessions'"
alias ta='tmux attach-session'
alias to='tmux attach-session -t'
alias tk='tmux kill-session -t'
