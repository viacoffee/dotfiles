# Stats
alias top='btop'
alias htop='btop'
alias ping='prettyping --nolegend'

# Vim
alias vi='nvim'
alias vim='nvim'

# Directory listings
alias l='lsd -a1'
alias la='lsd -la'
alias lr='lsd -R'
alias lra='lsd -RA'
alias lt='lsd --tree'

# Git
alias gs='git status'
alias gl='git log'
alias gp='git pull'
alias gd='git diff'

# General
alias c='clear'

# Navigation
alias ...='cd ../..'
alias ....='cd ../../..'
