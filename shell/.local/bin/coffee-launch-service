#!/bin/bash
name="${1:-}"

# Guard against missing name
if [[ -z "$name" ]]; then
    exit 1
fi

# Include service_helper.sh for the set_service_vars function
. "$( dirname "${BASH_SOURCE[0]}" )/includes/service_helper.sh"
if ! set_service_vars "$name"; then
    notify-send "unknown service $name"
    exit 1
fi

# Make sure the service isn't running already
if ! pgrep -x $pidname >/dev/null; then
    # start
    systemctl start "${service}"
    # notify and exit on error
    if [ $? -ne 0 ]; then
        notify-send -u critical "$name($service) failed to start"
        exit 1
    fi
    notify-send "$name has been started"

    # Trigger waybar update if we have a signal
    if [[ -n "$signal" ]]; then
        pkill $signal waybar
    fi
else
    notify-send "$name is already running"
fi
