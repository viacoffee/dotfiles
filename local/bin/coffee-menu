#!/usr/bin/env bash

# Exit after submenu when launched directly
BACK_TO_EXIT=false

############################
# Helpers
############################

back_to() {
  local parent="$1"

  if [[ "$BACK_TO_EXIT" == true ]]; then
    exit 0
  elif [[ -n "$parent" ]]; then
    "$parent"
  else
    show_main_menu
  fi
}

menu() {
  local placeholder="$1"
  local options="$2"

  echo -e "$options" | fuzzel \
    --dmenu \
    --placeholder="$placeholder" \
    2>/dev/null
}

terminal() {
  xdg-terminal-exec "$@"
}

open_in_editor() {
  notify-send "Editing" "$1"
  ${EDITOR:-nvim} "$1"
}

install() {
  present_terminal "echo Installing $1... && sudo pacman -S --noconfirm $2"
}

aur_install() {
  present_terminal "echo Installing $1... && yay -S --noconfirm $2"
}

############################
# Capture Menus
############################

show_screenshot_menu() {
  case $(menu "Screenshot…" \
"󰹑  Full Screen
󰆞  Selection
󰍹  Window") in

  *Full*) grim ~/Pictures/shot-$(date +%s).png ;;
  *Selection*) grim -g "$(slurp)" ~/Pictures/shot-$(date +%s).png ;;
  *Window*) grim -g "$(slurp -w)" ~/Pictures/shot-$(date +%s).png ;;
  *) back_to show_capture_menu ;;
  esac
}

show_screenrecord_menu() {
  case $(menu "Record…" \
"  Start
  Stop") in

  *Start*) wf-recorder -f ~/Videos/rec-$(date +%s).mp4 ;;
  *Stop*) pkill wf-recorder ;;
  *) back_to show_capture_menu ;;
  esac
}

show_capture_menu() {
  case $(menu "Capture…" \
"  Screenshot
  Screenrecord") in

  *Screenshot*) show_screenshot_menu ;;
  *Screenrecord*) show_screenrecord_menu ;;
  *) back_to show_main_menu ;;
  esac
}

############################
# System Menu
############################

show_system_menu() {
  case $(menu "System…" \
"  Lock
󰜉  Restart
󰐥  Shutdown") in

  *Lock*)
    exec sh -c "coffee-lock-screen"
    ;;
  *Restart*)
    exec sh -c "coffee-cmd-reboot"
    ;;
  *Shutdown*)
    exec sh -c "coffee-cmd-shutdown"
    ;;
  *) back_to show_main_menu ;;
  esac
}

############################
# Install Menu
############################

show_install_menu() {
  case $(menu "Install…" \
"󰏖  Neovim
󰏖  Firefox
󰏖  Docker
󰏖  VLC") in

  *Neovim*) install "Neovim" neovim ;;
  *Firefox*) install "Firefox" firefox ;;
  *Docker*) install "Docker" docker ;;
  *VLC*) install "VLC" vlc ;;
  *) back_to show_main_menu ;;
  esac
}

############################
# Setup Menu
############################

show_setup_menu() {
  case $(menu "Setup…" \
"  Edit niri config
  Edit fuzzel config
  Reload WM") in

  *niri*) open_in_editor ~/.config/niri/config.kdl ;;
  *fuzzel*) open_in_editor ~/.config/fuzzel/fuzzel.ini ;;
  *Reload*) pkill -USR1 niri ;;
  *) back_to show_main_menu ;;
  esac
}

############################
# Main Navigation
############################

go_to_menu() {
  case "${1,,}" in
    *apps*) coffee-menu-apps ;;
    *setup*) show_setup_menu ;;
    *install*) show_install_menu ;;
    *capture*) show_capture_menu ;;
    *system*) show_system_menu ;;
  esac
}

show_main_menu() {
  go_to_menu "$(menu "Go…" \
"󰀻  Apps
  Setup
󰉉  Install
  Capture
  System")"
}

############################
# Entry Point
############################

if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
