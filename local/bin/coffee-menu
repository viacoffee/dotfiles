#!/bin/bash

if [[ "$1" == power ]]; then
  options="  Lock
  Restart
  Shutdown"

  case $(coffee-launch-menu " Power" <<< "$options") in
    *Lock*)     coffee-lock-screen ;;
    *Restart*)  coffee-cmd-reboot ;;
    *Shutdown*) coffee-cmd-shutdown ;;
  esac
  exit
fi

options="  Screenrecord (desktop audio)
  Screenrecord (desktop + mic)
  Sound
  Wifi
  Bluetooth"

case $(coffee-launch-menu " Menu" <<< "$options") in
  *"desktop + mic"*)  coffee-cmd-screenrecord --with-desktop-audio --with-microphone ;;
  *"desktop audio"*)  coffee-cmd-screenrecord --with-desktop-audio ;;
  *Sound*)            coffee-launch-term-float wiremix ;;
  *Wifi*)             coffee-launch-wifi ;;
  *Bluetooth*)        coffee-launch-bluetooth ;;
esac
