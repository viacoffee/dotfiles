#!/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
PACKAGE_DIR=${DOT_DEV_PACKAGE_DIR:-"$SCRIPT_DIR/../lib/dot-dev"}

usage() {
  cat <<EOF
Usage:
  dot-dev
  dot-dev status [package]
  dot-dev install <package>
  dot-dev remove <package>

Available packages:
$(package_names | sed 's/^/  /')
EOF
}

package_names() {
  local script

  [[ -d $PACKAGE_DIR ]] || return 0

  while IFS= read -r script; do
    basename "$script"
  done < <(find "$PACKAGE_DIR" -maxdepth 1 -type f -printf '%f\n' | sort)
}

package_script() {
  local package=$1
  local candidate="$PACKAGE_DIR/$package"

  [[ $package =~ ^[a-z0-9][a-z0-9-]*$ ]] || return 1
  [[ -f $candidate ]] || return 1
  printf '%s\n' "$candidate"
}

run_package() {
  local package=$1
  local operation=$2
  local script

  script=$(package_script "$package") || {
    printf 'Unknown development environment: %s\n' "$package" >&2
    return 2
  }

  bash "$script" "$operation"
}

aggregate_status() {
  local package state

  printf 'Available development environments:\n'
  while IFS= read -r package; do
    [[ -n $package ]] || continue
    state=$(run_package "$package" summary) || state='not installed'
    if [[ $state != installed && $state != 'not installed' ]]; then
      state='not installed'
    fi
    printf '  %-16s %s\n' "$package" "$state"
  done < <(package_names)
}

main() {
  case ${1:-status} in
    status)
      case $# in
        0|1) aggregate_status ;;
        2) run_package "$2" status ;;
        *) usage >&2; return 2 ;;
      esac
      ;;
    install|remove)
      (($# == 2)) || { usage >&2; return 2; }
      run_package "$2" "$1"
      ;;
    -h|--help)
      (($# == 1)) || { usage >&2; return 2; }
      usage
      ;;
    *)
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
