#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: dot-snapshot <create|list|restore|delete>" >&2
  exit 1
}

latest_snapshot() {
  sudo snapper -c root --csvout list | awk -F, 'NR > 1 { id = $1 } END { print id }'
}

create() {
  printf '\e[32mCreate system snapshot\e[0m\n'
  sudo snapper -c root create -c number
  echo
}

list() {
  printf '\e[32mroot\e[0m\n'
  sudo snapper -c root list
}

restore() {
  sudo limine-snapper-restore
}

delete() {
  printf '\e[32mDelete latest snapshot\e[0m\n'

  local latest
  latest=$(latest_snapshot)
  if [[ -n $latest && $latest != 0 ]]; then
    sudo snapper -c root delete "$latest"
  fi

  echo
}

case "${1:-}" in
  create) create ;;
  list) list ;;
  restore) restore ;;
  delete) delete ;;
  *) usage ;;
esac
