#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: dot-snapshot <create|list|restore|delete> [snapshot-number]" >&2
  exit 1
}

create() {
  printf '\e[32mCreate system snapshot\e[0m\n'
  sudo snapper -c root create -c number
  echo
}

list() {
  local snapshots rows total

  snapshots=$(sudo snapper -c root --jsonout list --columns number,date,cleanup,used-space,description)
  rows=$(jq -r '
    [.. | objects | select(has("number"))]
    | map(select(.number != 0))
    | sort_by(.number)
    | .[]
    | [
        (.number | tostring),
        (.date // "-"),
        (.cleanup // "-" | if . == "" then "-" else . end),
        (."used-space" | if . == null then "-" else tostring end),
        (.description // "" | if . == "" then "(no description)" else . end)
      ]
    | @tsv
  ' <<<"$snapshots")

  printf '\e[32mSnapshots\e[0m\n\n'
  printf '%4s  %-19s %-8s %10s  %s\n' NUMBER DATE CLEANUP SIZE DESCRIPTION

  if [[ -n $rows ]]; then
    while IFS=$'\t' read -r number date cleanup used_space description; do
      if [[ $used_space != - ]]; then
        used_space=$(numfmt --to=iec-i --suffix=B --format='%.1f' "$used_space")
      fi
      printf '%4s  %-19s %-8s %10s  %s\n' \
        "$number" "$date" "$cleanup" "$used_space" "$description"
    done <<<"$rows"
  fi

  total=$(jq -r '
    [.. | objects | select(has("number"))]
    | map(select(.number != 0))
    | map(."used-space" // 0)
    | add // 0
  ' <<<"$snapshots")

  printf '\nTotal: %s\n' "$(numfmt --to=iec-i --suffix=B --format='%.1f' "$total")"
}

restore() {
  sudo limine-snapper-restore
}

delete() {
  local snapshot_number=${1:-}

  if [[ ! $snapshot_number =~ ^[1-9][0-9]*$ ]]; then
    echo "A snapshot number from 'dot-snapshot list' is required." >&2
    exit 1
  fi

  printf '\e[32mDelete snapshot %s\e[0m\n' "$snapshot_number"
  if ! sudo snapper -c root delete "$snapshot_number"; then
    echo "Failed to delete snapshot $snapshot_number." >&2
    return 1
  fi
  printf '\e[32mDeleted snapshot %s\e[0m\n\n' "$snapshot_number"
}

case "${1:-}" in
  create) create ;;
  list) list ;;
  restore) restore ;;
  delete) delete "${2:-}" ;;
  *) usage ;;
esac
