#!/bin/bash
#
# coffee-theme-refresh — Build themed configs from palette.toml + templates
#
# Usage:
#   coffee-theme-refresh                    Generate from active palette
#   coffee-theme-refresh --palette <name>   Switch to a named palette and generate
#   coffee-theme-refresh --reload           Generate and reload running apps
#   coffee-theme-refresh --env              Print exported variables (for sourcing)
#   coffee-theme-refresh --list             List available palettes
#
# Palette files live in config/theme/ as palette-<name>.toml.
# The active palette is always config/theme/palette.toml (a symlink or file).

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
THEME_DIR="$DOTFILES/config/theme"
TEMPLATE_DIR="$THEME_DIR/templates"
PALETTE="$THEME_DIR/palette.toml"
GENERATED_ENV="$THEME_DIR/colors.sh"

# ---------------------------------------------------------------------------
# Parse palette.toml and export shell variables
# ---------------------------------------------------------------------------
hex_to_rgb() {
  local hex="${1#\#}"
  printf "%d %d %d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

# Collect all variable names for envsubst whitelist
THEME_VARS=()

_export_var() {
  local name="$1" val="$2"
  export "${name}=${val}"
  THEME_VARS+=("\${${name}}")
}

parse_palette() {
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    [[ "$line" =~ ^\[.*\] ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      local KEY="${key^^}"

      # Skip non-color metadata
      [[ "$KEY" == "NAME" ]] && { _export_var THEME_NAME "$val"; continue; }

      local hex="${val#\#}"
      local rgb
      rgb=$(hex_to_rgb "$val")
      local r g b
      read -r r g b <<< "$rgb"

      # Standard formats
      _export_var "$KEY"           "$val"                                # #RRGGBB
      _export_var "${KEY}_RAW"     "$hex"                                # RRGGBB
      _export_var "${KEY}_FF"      "${hex}ff"                            # RRGGBBff
      _export_var "${KEY}_D0"      "${hex}d0"                            # RRGGBBd0
      _export_var "${KEY}_A2"      "${hex}a2"                            # RRGGBBa2
      _export_var "${KEY}_F2"      "${hex}f2"                            # RRGGBBF2
      _export_var "${KEY}_RGBA_1"  "rgba(${r}, ${g}, ${b}, 1.0)"        # rgba(R, G, B, 1.0)
      _export_var "${KEY}_RGBA_04" "rgba(${r}, ${g}, ${b}, 0.4)"        # rgba(R, G, B, 0.4)
      _export_var "${KEY}_RGBA_0"  "rgba(${r}, ${g}, ${b}, 0)"          # rgba(R, G, B, 0)
      _export_var "${KEY}_CSS_085" "rgba(${r}, ${g}, ${b}, 0.85)"       # rgba(R, G, B, 0.85)
      _export_var "${KEY}_CSS_08"  "rgba(${r}, ${g}, ${b}, 0.8)"        # rgba(R, G, B, 0.8)
      _export_var "${KEY}_CSS_095" "rgba(${r}, ${g}, ${b}, 0.95)"       # rgba(R, G, B, 0.95)
      _export_var "${KEY}_ANSI"    "\u001b[38;2;${r};${g};${b}m"        # ANSI 24-bit fg
    fi
  done < "$PALETTE"

  # ANSI formatting helpers (not palette-derived)
  _export_var ANSI_BOLD     "\u001b[1m"
  _export_var ANSI_BOLD_OFF "\u001b[22m"
  _export_var ANSI_RESET    "\u001b[0m"

  # Black with alpha variants (used in floating UI backgrounds)
  _export_var BLACK_D0       "000000d0"
  _export_var BLACK_F2       "0f0f0ff2"
  _export_var BLACK_CSS_085  "rgba(0, 0, 0, 0.85)"
  _export_var BLACK_CSS_08   "rgba(0, 0, 0, 0.8)"
  _export_var BLACK_CSS_095  "rgba(0, 0, 0, 0.95)"
  _export_var BLACK_RGBA_04  "rgba(0, 0, 0, 0.4)"
  _export_var BLACK_RGBA_0   "rgba(0, 0, 0, 0)"

  # Near-black border for swayosd
  _export_var DARK_BORDER_CSS_095 "rgba(25, 25, 25, 0.95)"

  # Build the envsubst whitelist string
  ENVSUBST_VARS=$(IFS=,; echo "${THEME_VARS[*]}")
}

# ---------------------------------------------------------------------------
# Generate config files from templates
# ---------------------------------------------------------------------------
generate() {
  local template="$1"
  local output="$2"
  local name
  name=$(basename "$template")

  mkdir -p "$(dirname "$output")"
  envsubst "$ENVSUBST_VARS" < "$template" > "$output"
  echo "  $name → $output"
}

# ---------------------------------------------------------------------------
# Write colors.sh for runtime sourcing by scripts
# ---------------------------------------------------------------------------
write_env_file() {
  {
    echo "#!/bin/bash"
    echo "# Auto-generated by coffee-theme-refresh — do not edit"
    echo "# Source this file: . \"\$HOME/.config/theme/colors.sh\""
    echo ""
    env | grep -E '^(BG|FG|SURFACE|GRAY|INACTIVE|PROC_MISC|RED|GREEN|YELLOW|BLUE|MAGENTA|CYAN|DIM_|BRIGHT_|BLACK_|DARK_BORDER|ANSI_|THEME_)' | sort | while IFS='=' read -r key val; do
      echo "export ${key}=\"${val}\""
    done
  } > "$GENERATED_ENV"
}

# ---------------------------------------------------------------------------
# Template → output path mapping
# ---------------------------------------------------------------------------
build_all() {
  echo "Building theme: ${THEME_NAME:-coffee}"
  echo ""

  generate "$TEMPLATE_DIR/alacritty.toml"      "$DOTFILES/config/alacritty/alacritty.toml"
  generate "$TEMPLATE_DIR/waybar-style.css"     "$DOTFILES/config/waybar/style.css"
  generate "$TEMPLATE_DIR/fuzzel.ini"           "$DOTFILES/config/fuzzel/fuzzel.ini"
  generate "$TEMPLATE_DIR/mako-config"          "$DOTFILES/config/mako/config"
  generate "$TEMPLATE_DIR/hyprlock.conf"        "$DOTFILES/config/hypr/hyprlock.conf"
  generate "$TEMPLATE_DIR/swayosd-style.css"    "$DOTFILES/config/swayosd/style.css"
  generate "$TEMPLATE_DIR/btop-coffee.theme"    "$DOTFILES/config/btop/themes/coffee.theme"
  generate "$TEMPLATE_DIR/starship.toml"        "$DOTFILES/config/starship.toml"
  generate "$TEMPLATE_DIR/fastfetch.jsonc"      "$DOTFILES/config/fastfetch/config.jsonc"

  echo ""
  write_env_file
  echo "  colors.sh → $GENERATED_ENV"

  echo ""
  echo "Done. Generated $(find "$TEMPLATE_DIR" -type f | wc -l) configs + colors.sh"
}

# ---------------------------------------------------------------------------
# Reload running applications
# ---------------------------------------------------------------------------
reload_apps() {
  echo ""
  echo "Reloading apps..."

  # Alacritty auto-watches its config — no action needed
  # Starship re-reads config every prompt — no action needed
  # Niri auto-watches config — no action needed

  # Waybar: SIGUSR2 triggers reload
  pgrep -x waybar > /dev/null && pkill -SIGUSR2 waybar && echo "  waybar reloaded" || true

  # Mako: makoctl reload
  pgrep -x mako > /dev/null && makoctl reload && echo "  mako reloaded" || true

  echo ""
  echo "Note: btop and swayosd require restart to pick up changes."
}

# ---------------------------------------------------------------------------
# List available palettes
# ---------------------------------------------------------------------------
list_palettes() {
  local active_name=""
  if [[ -f "$PALETTE" ]]; then
    active_name=$(grep -m1 'name' "$PALETTE" 2>/dev/null | sed 's/.*"\(.*\)"/\1/')
  fi

  echo "Available palettes:"
  for f in "$THEME_DIR"/palette-*.toml; do
    [[ -f "$f" ]] || continue
    local name
    name=$(basename "$f" .toml)
    name="${name#palette-}"
    local display_name
    display_name=$(grep -m1 'name' "$f" 2>/dev/null | sed 's/.*"\(.*\)"/\1/')
    if [[ "$display_name" == "$active_name" ]]; then
      echo "  * $name ($display_name) [active]"
    else
      echo "    $name ($display_name)"
    fi
  done
}

# ---------------------------------------------------------------------------
# Switch active palette
# ---------------------------------------------------------------------------
switch_palette() {
  local name="$1"
  local palette_file="$THEME_DIR/palette-${name}.toml"

  if [[ ! -f "$palette_file" ]]; then
    echo "Error: Palette '$name' not found at $palette_file" >&2
    echo ""
    list_palettes
    exit 1
  fi

  cp "$palette_file" "$PALETTE"
  echo "Switched to palette: $name"
  echo ""
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
  local do_reload=false
  local palette_name=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list)
        list_palettes
        return
        ;;
      --env)
        if [[ ! -f "$PALETTE" ]]; then
          echo "Error: Palette not found at $PALETTE" >&2
          exit 1
        fi
        parse_palette
        env | grep -E '^(BG|FG|SURFACE|GRAY|INACTIVE|PROC_MISC|RED|GREEN|YELLOW|BLUE|MAGENTA|CYAN|DIM_|BRIGHT_|BLACK_|DARK_BORDER|ANSI_|THEME_)' | sort
        return
        ;;
      --palette)
        shift
        palette_name="${1:-}"
        if [[ -z "$palette_name" ]]; then
          echo "Error: --palette requires a name" >&2
          exit 1
        fi
        ;;
      --reload)
        do_reload=true
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  if [[ -n "$palette_name" ]]; then
    switch_palette "$palette_name"
  fi

  if [[ ! -f "$PALETTE" ]]; then
    echo "Error: Palette not found at $PALETTE" >&2
    exit 1
  fi

  parse_palette
  build_all

  if [[ "$do_reload" == true ]]; then
    reload_apps
  fi
}

main "$@"
