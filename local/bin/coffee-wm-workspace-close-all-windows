#!/bin/bash

# Include niri helpers
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/niri-helpers.sh"

unfocused=false

for arg in "$@"; do
  case "$arg" in
    --unfocused)
      unfocused=true
      ;;
  esac
done

if $unfocused; then
  niri_windows_on_focused_workspace |
    niri_unfocused_window_ids |
    _niri_message_to_ids close-window
else
  niri_windows_on_focused_workspace |
    _niri_message_to_ids close-window
fi

# niri_focus_or_spawn "coffee.about" "coffee-launch-about"
