#!/bin/bash

if [[ "$1" == power ]]; then
  options="  Lock
  Suspend
  Restart
  Shutdown"

  case $(dot-launch-menu "" <<< "$options") in
    *Lock*)     dot-lock-screen ;;
    *Suspend*)  dot-cmd-suspend ;;
    *Restart*)  dot-cmd-reboot ;;
    *Shutdown*) dot-cmd-shutdown ;;
  esac
  exit
fi

options="Sound
  Wifi
  Bluetooth"

case $(dot-launch-menu "" <<< "$options") in
  *Sound*)            dot-launch-term-float wiremix ;;
  *Wifi*)             dot-launch-wifi ;;
  *Bluetooth*)        dot-launch-bluetooth ;;
esac
