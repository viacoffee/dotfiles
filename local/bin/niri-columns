#!/usr/bin/env bash
set -euo pipefail

layout="horizontal"
inactive="○"
active="●"
hide_single=false
output_format=json

while [[ $# -gt 0 ]]; do
  case "$1" in
    --layout)
      [[ $# -ge 2 && "$2" =~ ^(horizontal|vertical)$ ]] || { printf 'invalid layout\n' >&2; exit 2; }
      layout="$2"
      shift 2
      ;;
    --inactive)
      [[ $# -ge 2 ]] || { printf '%s requires a value\n' "$1" >&2; exit 2; }
      inactive="$2"
      shift 2
      ;;
    --active)
      [[ $# -ge 2 ]] || { printf '%s requires a value\n' "$1" >&2; exit 2; }
      active="$2"
      shift 2
      ;;
    --hide-single)
      hide_single=true
      shift
      ;;
    --output=*)
      output_format="${1#--output=}"
      [[ "$output_format" =~ ^(json|plain)$ ]] || { printf 'invalid output format\n' >&2; exit 2; }
      shift
      ;;
    *)
      printf 'unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

# Return the ID of the focused workspace. Query workspaces rather than windows so
# this also works when the workspace is empty.
niri_focused_workspace_id() {
  niri msg --json workspaces |
    jq -r '.[] | select(.is_focused) | .id'
}

# Return non-floating windows ordered by their scrolling-layout position.
niri_tiled_windows_on_workspace_sorted() {
  local workspace_id="$1"

  niri msg --json windows |
    jq -c --argjson workspace_id "$workspace_id" '
      map(select(.workspace_id == $workspace_id and (.is_floating | not)))
      | sort_by([
          .layout.pos_in_scrolling_layout[0],
          .layout.pos_in_scrolling_layout[1]
        ])
      | .[]
    '
}

emit() {
  local text="$1"

  case "$output_format" in
    json)
      jq -cn --arg text "$text" '{text: $text}'
      ;;
    plain)
      printf '%s\n' "$text"
      ;;
    *)
      printf 'invalid output format: %s\n' "$output_format" >&2
      return 2
      ;;
  esac
}

render() {
  local workspace_id text separator window column current_column focused
  local column_index
  local -a windows dots

  workspace_id="$(niri_focused_workspace_id 2>/dev/null || true)"
  if [[ -z "$workspace_id" ]]; then
    emit ""
    return
  fi

  mapfile -t windows < <(
    niri_tiled_windows_on_workspace_sorted "$workspace_id" |
      jq -r '[.layout.pos_in_scrolling_layout[0], (.is_focused | tostring)] | @tsv'
  )

  dots=()
  column=""
  column_index=-1
  for window in "${windows[@]}"; do
    IFS=$'\t' read -r current_column focused <<< "$window"
    if [[ "$current_column" != "$column" ]]; then
      column="$current_column"
      dots+=("$inactive")
      column_index=$((column_index + 1))
    fi

    if [[ "$focused" == true ]]; then
      dots[column_index]="$active"
    fi
  done

  if "$hide_single" && ((${#dots[@]} <= 1)); then
    emit ""
    return
  fi

  if [[ "$layout" == vertical ]]; then
    separator=$'\n'
  else
    separator=' '
  fi

  text="$(IFS="$separator"; printf '%s' "${dots[*]:-}")"
  emit "$text"
}

render

# Keep one IPC connection open. Only these events can change the indicator:
# focus changes, window membership/order changes, and workspace activation.
is_relevant_event() {
  jq -e '
    [keys[]]
    | any(test("^(WindowFocusChanged|WindowOpenedOrChanged|WindowClosed|WindowsChanged|WindowLayoutsChanged|WorkspaceActivated|WorkspacesChanged)$"))
  ' >/dev/null 2>&1
}

# Coalesce event bursts (for example, opening a window can produce several
# related events) without introducing polling latency during normal use.
last_render_ns=0
render_if_needed() {
  local now elapsed
  now="$(date +%s%N)"
  elapsed=$((now - last_render_ns))
  if ((elapsed < 50000000)); then
    return
  fi
  last_render_ns="$now"
  render
}

# Reconnect if the compositor or IPC stream restarts.
while true; do
  while IFS= read -r event; do
    if is_relevant_event <<< "$event"; then
      render_if_needed
    fi
  done < <(niri msg --json event-stream 2>/dev/null)
  sleep 1
done
