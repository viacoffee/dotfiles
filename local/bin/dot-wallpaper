#!/bin/bash
#
# dot-wallpaper — Set desktop wallpaper from a URL or file path
#
# Usage:
#   dot-wallpaper <url-or-path>
#
# Copies or downloads the image to ~/background.jpg (always .jpg),
# Hyprlock picks the file up automatically on the next lock.

set -euo pipefail

TARGET="$HOME/background.jpg"

usage() {
  echo "Usage: dot-wallpaper <url-or-path>"
  echo "  Sets the desktop wallpaper from a URL or local file."
  exit 1
}

[[ $# -lt 1 ]] && usage
src="$1"

if [[ "$src" =~ ^https?:// ]]; then
  echo "Downloading $src..."
  curl -fSL -o "$TARGET" "$src"
else
  [[ ! -f "$src" ]] && { echo "Error: File not found: $src" >&2; exit 1; }
  cp "$src" "$TARGET"
  echo "Copied $src → $TARGET"
fi

echo "Done. Wallpaper updates!"
