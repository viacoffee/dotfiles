#!/usr/bin/env bash

menu=$(cat <<EOF
  Lock
  Niri Refresh
  Reboot
  Shutdown
EOF
)

choice=$(echo "$menu" | fuzzel --dmenu --width=18 --placeholder=System…)

case "$choice" in
  *Lock)
    exec sh -c "coffee-lock-screen"
    ;;
  *Reboot)
    exec sh -c "coffee-cmd-reboot"
    ;;
  *Shutdown)
    exec sh -c "coffee-cmd-shutdown"
    ;;
esac
