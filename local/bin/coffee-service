#!/bin/bash

# Include general helpers
. "$( dirname "${BASH_SOURCE[0]}" )/lib/helpers.sh"
# Include service_helpers.sh for the service_action function
. "$( dirname "${BASH_SOURCE[0]}" )/lib/service-helpers.sh"

action="${1:-toggle}"
name="${2:-}"

# Guard against missing name
[[ -z "$name" ]] && exit 0

service_action "$action" "$name"
