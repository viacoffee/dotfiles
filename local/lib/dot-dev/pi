#!/bin/bash
set -euo pipefail

PI_PACKAGES=(nodejs npm glow)
PI_NPM_PACKAGE=@earendil-works/pi-coding-agent

package_installed() {
  pacman -Q "$1" >/dev/null 2>&1
}

pi_installed() {
  command -v npm >/dev/null 2>&1 &&
    npm list --global --prefix "$HOME/.local" --depth=0 "$PI_NPM_PACKAGE" >/dev/null 2>&1 &&
    command -v pi >/dev/null 2>&1
}

summary() {
  if pi_installed; then printf 'installed\n'; else printf 'not installed\n'; fi
}

status() {
  local package state

  printf 'Pi environment:\n'
  for package in "${PI_PACKAGES[@]}"; do
    if package_installed "$package"; then state=installed; else state=missing; fi
    printf '  %-16s %s\n' "$package" "$state"
  done

  if command -v pi >/dev/null 2>&1; then
    printf '  %-16s installed (%s)\n' pi "$(pi --version 2>/dev/null || printf 'version unknown')"
  else
    printf '  %-16s missing\n' pi
  fi
}

install() {
  sudo pacman -S --needed "${PI_PACKAGES[@]}"
  npm install --global --ignore-scripts --prefix "$HOME/.local" "$PI_NPM_PACKAGE"
  printf '\nPi and Glow are installed. Run pi and use /login before using Hivemind.\n'
}

remove() {
  local answer package
  local -a installed_packages=()

  read -r -p 'Remove Pi, Glow, Node.js, and npm? [y/N] ' answer
  [[ $answer =~ ^[Yy]([Ee][Ss])?$ ]] || { printf 'Pi removal cancelled.\n'; return 0; }

  if command -v npm >/dev/null 2>&1 &&
    npm list --global --prefix "$HOME/.local" --depth=0 "$PI_NPM_PACKAGE" >/dev/null 2>&1; then
    npm uninstall --global --prefix "$HOME/.local" "$PI_NPM_PACKAGE"
  fi

  for package in "${PI_PACKAGES[@]}"; do
    package_installed "$package" && installed_packages+=("$package")
  done
  if ((${#installed_packages[@]})); then sudo pacman -Rns --noconfirm "${installed_packages[@]}"; fi

  printf '\nPi and its system packages were removed. ~/.pi was preserved.\n'
}

main() {
  case ${1:-status} in
    summary) summary ;;
    status) status ;;
    install) install ;;
    remove) remove ;;
    *) return 2 ;;
  esac
}

main "$@"
