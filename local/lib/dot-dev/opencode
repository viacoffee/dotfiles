#!/bin/bash
set -euo pipefail

OPENCODE_PACKAGE=opencode

package_installed() {
  pacman -Q "$1" >/dev/null 2>&1
}

opencode_installed() {
  package_installed "$OPENCODE_PACKAGE" && command -v opencode >/dev/null 2>&1
}

summary() {
  if opencode_installed; then printf 'installed\n'; else printf 'not installed\n'; fi
}

status() {
  local state

  printf 'OpenCode environment:\n'
  if package_installed "$OPENCODE_PACKAGE"; then state=installed; else state=missing; fi
  printf '  %-16s %s\n' "$OPENCODE_PACKAGE" "$state"

  if command -v opencode >/dev/null 2>&1; then
    printf '  %-16s installed (%s)\n' opencode "$(opencode --version 2>/dev/null || printf 'version unknown')"
  else
    printf '  %-16s missing\n' opencode
  fi
}

install() {
  sudo pacman -S --needed "$OPENCODE_PACKAGE"
  printf '\nOpenCode is installed. Run opencode to get started.\n'
}

remove() {
  local answer

  read -r -p 'Remove OpenCode? Its user configuration will be preserved. [y/N] ' answer
  [[ $answer =~ ^[Yy]([Ee][Ss])?$ ]] || { printf 'OpenCode removal cancelled.\n'; return 0; }

  if package_installed "$OPENCODE_PACKAGE"; then sudo pacman -Rns --noconfirm "$OPENCODE_PACKAGE"; fi
  printf '\nOpenCode was removed. Its user configuration was preserved.\n'
}

main() {
  case ${1:-status} in
    summary) summary ;;
    status) status ;;
    install) install ;;
    remove) remove ;;
    *) return 2 ;;
  esac
}

main "$@"
