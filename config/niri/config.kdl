prefer-no-csd
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"

// -------------------------------------------------------------------
// Inputs
// -------------------------------------------------------------------
input {
  focus-follows-mouse

  keyboard {
    xkb {}

    numlock
  }
}

// -------------------------------------------------------------------
// Output/display
// -------------------------------------------------------------------
/-output "eDP-1" {
  // niri msg outputs
}

// -------------------------------------------------------------------
// Layout
// -------------------------------------------------------------------
layout {
  gaps 10
  always-center-single-column
  center-focused-column "on-overflow"

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  focus-ring {
    width 1
    active-color "#7fc8ff"
    inactive-color "#505050"
  }

  border {
    width 1
    active-gradient from="#e5c07b" to="#56b6c2" angle=45 in="oklch longer hue"
    inactive-color "#505050"
    urgent-color "#9b0000"
  }
}

cursor {
  xcursor-theme "breeze_cursors"
  xcursor-size 48
  hide-when-typing
  hide-after-inactive-ms 1000
}

// -------------------------------------------------------------------
// Keybinds
// -------------------------------------------------------------------
hotkey-overlay {
  skip-at-startup
  hide-not-bound
}

// System
binds {
  //Mod+Shift+r { reload-config; }
  Mod+Return { spawn "alacritty"; }

  // Lock
  Mod+Shift+q {
    spawn "sh" "-c" "coffee-lock-screen"
  }

  // Clipboard
  Mod+C { spawn "sh" "-c" "wl-paste | wl-copy"; }
  Mod+V { spawn "wl-paste"; }

  // Power walker menu
  Mod+Escape {
    spawn "sh" "-c" "coffee-menu-power"
  }

  // General walker menu
  Mod+Alt+Space {
    spawn "sh" "-c" "coffee-menu"
  }

  // Window focus
  Mod+h { focus-column-left; }
  Mod+j { focus-window-down; }
  Mod+k { focus-window-up; }
  Mod+l { focus-column-right; }

  // Cycle within column
  Mod+n { focus-window-down; }
  Mod+p { focus-window-up; }

  // Move windows (shift)
  Mod+Shift+h { move-column-left; }
  Mod+Shift+l { move-column-right; }
  Mod+Shift+j { move-window-down; }
  Mod+Shift+k { move-window-up; }

  // Resize windows
  Mod+Ctrl+h { set-window-height "+10%"; }
  Mod+Ctrl+l { set-column-width "+10%"; }
  Mod+Ctrl+j { set-window-height "-10%"; }
  Mod+Ctrl+k { set-column-width "+10%"; }

  // Layout & window actions
  Mod+w { close-window; }
  Mod+f { fullscreen-window; }
  Mod+t { toggle-window-floating; }

  // Close all but the focused window
  Mod+Shift+W {
    spawn "sh" "-c" "niri_close_all_but_focused"
  }

  // Workspaces
  Mod+1 { focus-workspace 1; }
  Mod+2 { focus-workspace 2; }
  Mod+3 { focus-workspace 3; }
  Mod+4 { focus-workspace 4; }
  Mod+5 { focus-workspace 5; }

  Mod+Shift+1 { move-window-to-workspace 1; }
  Mod+Shift+2 { move-window-to-workspace 2; }
  Mod+Shift+3 { move-window-to-workspace 3; }
  Mod+Shift+4 { move-window-to-workspace 4; }
  Mod+Shift+5 { move-window-to-workspace 5; }

  // Screengrabs
  // Area to clipboard
  //Mod+p {
  //  spawn "grim -g \"$(slurp)\" - | wl-copy"
  //}

  // Area to file
  Mod+Shift+p {
    spawn "grim -g \"$(slurp)\" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"
  }

  // Screen to file
  Mod+Shift+Ctrl+p {
    spawn "grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png"
  }

  Ctrl+Alt+Delete { quit; }
}
