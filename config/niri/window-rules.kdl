// For floating windows and misc system/about tuis
window-rule {
  match app-id="coffee.float"
  match app-id="coffee.float-tui"
  match app-id="org.gnome.Nautilus"
  match app-id="mpv"
  match app-id="imv"

  open-floating true
  open-focused true

  default-window-height { proportion 0.4; }
  default-column-width { proportion 0.3; }
}

// Firefox Picture-in-Picture
window-rule {
  match app-id="firefox$" title="^Picture-in-Picture$"

  open-floating true
  default-column-width { fixed 480; }
  default-window-height { fixed 270; }
}

// Steam dialogs
window-rule {
    match app-id=r#"steam"# title=r#".*(Steam|Friends|Settings|Properties|Path).*"#
    open-floating true
}

// Window currently being recorded — loud border so it's obvious what's live
window-rule {
  match is-window-cast-target=true

  border {
    width 2
    active-color "#e06c75"
    inactive-color "#e06c75"
  }
}
