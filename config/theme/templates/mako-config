# Global settings
max-history=10
default-timeout=5000
max-visible=5
anchor=top-right
default-timeout=5000
width=420

# Styling
font=InputMono Nerd Font 10
background-color=#${BLACK_D0}
text-color=#${FG_LIGHT_FF}
border-color=#${BG_ALT_RAW}f2
border-size=1
border-radius=4
width=300
padding=15
max-icon-size=32
outer-margin=20

# Formatting
format=<b>%s</b>\n<i>%b</i>

# Bindings
on-button-right=dismiss

[app-name=Spotify]
invisible=1

[mode=dnd]
invisible=1

[urgency=critical]
default-timeout=0
text-color=${RED}
