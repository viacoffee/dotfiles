[global]
font = InputMono Nerd Font 10
origin = top-right
offset = 20x20
width = 300
height = 100
padding = 15
frame_width = 1
frame_color = #1a1a1a
corner_radius = 6
gap_size = 10
icon_position = left
max_icon_size = 32
format = <b>%s</b>\n<i>%b</i>
sort = no
indicate_hidden = yes
stack_duplicates = yes

# History
sticky_history = yes
history_length = 20

# Input
mouse_left_click = close_current
mouse_middle_click = do_action
mouse_right_click = close_all

[urgency_low]
background = "#000000d0"
foreground = "#cfd8dc"
frame_color = "#1a1a1a"

[urgency_normal]
background = "#000000d0"
foreground = "#cfd8dc"
frame_color = "#1a1a1a"

[urgency_critical]
background = "#000000d0"
foreground = "#ef596f"
frame_color = "#1a1a1a"

# Spotify - hide notifications
[Spotify]
appname = Spotify
history_ignore = yes
