{
    "session": "niri",

    "components": [
        // "wallpaper",
        "bar",
        "notify",
        "osd"
    ],

    "wallpaper": {
        "path": "~/background.jpg",
        "mode": "fill"
    },

    "osd": {
        "position": "bottom-center",
        "timeout": 1,
        "display-percentage": true,
        "volume": { "increment": 3 },
        "brightness": { "increment": 5 }
    },

    "notify": {
        "position": "top-right",
        "timeout": 5,
        "lines": 4,
        "history": 5,
        "sticky-critical": true
    },

    "bar": {
        "orientation": "vertical",
        "thickness": 36,

        "left": ["time", "date", "idle", "dnd", "screenrecord"],
        "center": ["workspaces-niri", "workspaces-hyprland"],
        "right": ["battery", "column-indicator"],

        "items": {
            "time": { "type": "clock", "format": "%H\n%M" },
            "date": { "type": "clock", "format": "%d" },

            "idle": {
                "mode": "refresh",
                "kind": "text",
                "signal": 1,
                "command": "~/.config/kara/indicators/idle.sh"
            },
            "dnd": {
                "mode": "refresh",
                "kind": "text",
                "signal": 2,
                "command": "~/.config/kara/indicators/dnd.sh"
            },
            "screenrecord": {
                "mode": "refresh",
                "kind": "text",
                "signal": 3,
                "command": "~/.config/kara/indicators/screenrecord.sh"
            },

            "workspaces-niri": {
                "class": "workspaces",
                "session": "niri",
                "mode": "stream",
                "kind": "segments",
                "restart": "on-failure",
                "command": "kara-module-niri-workspaces"
            },
            "workspaces-hyprland": {
                "class": "workspaces",
                "session": "hyprland",
                "mode": "stream",
                "kind": "segments",
                "restart": "on-failure",
                "command": "kara-module-hyprland-workspaces",
                "on-click": ["kara-module-hyprland-workspaces", "--activate", "{segment_id}"]
            },
            "column-indicator": {
                "session": "niri",
                "mode": "stream",
                "kind": "text",
                "restart": "on-failure",
                "command": [
                    "niri-column-indicator",
                    "--layout", "vertical",
                    "--inactive", "\uf10c",
                    "--active", "\uf111",
                    "--hide-single"
                ]
            },

            "battery": {
                "on-click": ["dot-menu", "power"],
                "warning": 20,
                "critical": 10,
                "notify-critical": true,
                "format": {
                    "discharging": "{icon}",
                    "charging": "{icon}",
                    "plugged": "",
                    "full": "󰂅"
                },
                "icons": {
                    "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
                    "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
                }
            }
        }
    }
}
