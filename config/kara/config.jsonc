{
    "session": "niri",

    "components": [
        // "wallpaper",
        "bar",
        "notify",
        "osd"
    ],

    "wallpaper": {
        "path": "~/background.jpg",
        "mode": "fill"
    },

    "osd": {
        "position": "bottom-center",
        "timeout": 1,
        "display-percentage": true,
        "volume": { "increment": 3 },
        "brightness": { "increment": 5 }
    },

    "notify": {
        "position": "top-right",
        "timeout": 5,
        "lines": 4,
        "history": 5,
        "sticky-critical": true
    },

    "bar": {
        "orientation": "vertical",
        "thickness": 36,

        "modules": {
            "idle": {
                "mode": "refresh",
                "signal": 1,
                "command": "~/.config/kara/indicators/idle.sh"
            },
            "dnd": {
                "mode": "refresh",
                "signal": 2,
                "command": "~/.config/kara/indicators/dnd.sh"
            },
            "screenrecord": {
                "mode": "refresh",
                "signal": 3,
                "command": "~/.config/kara/indicators/screenrecord.sh"
            },
            "niri-column-indicator": {
                "session": "niri",
                "mode": "stream",
                "restart": "on-failure",
                "command": [
                    "niri-column-indicator",
                    "--layout", "vertical",
                    "--inactive", "\uf10c",
                    "--active", "\uf111",
                    "--hide-single"
                ]
            },
            "niri-workspaces": {
                "session": "niri",
                "mode": "stream",
                "restart": "on-failure",
                "command": "kara-module-niri-workspaces"
            },
            "hyprland-workspaces": {
                "session": "hyprland",
                "mode": "stream",
                "restart": "on-failure",
                "command": "kara-module-hyprland-workspaces"
            }
        },

        "left": [
            { "builtin": "time", "format": "%H\n%M" },
            { "builtin": "date", "format": "%d" },
            { "module": "idle", "kind": "text" },
            { "module": "dnd", "kind": "text" },
            { "module": "screenrecord", "kind": "text" }
        ],

        "center": [
            {
                "id": "workspaces-niri",
                "module": "niri-workspaces",
                "kind": "segments"
            },
            {
                "id": "workspaces-hyprland",
                "module": "hyprland-workspaces",
                "kind": "segments",
                "on-click": ["kara-module-hyprland-workspaces", "--activate", "{segment_id}"]
            }
        ],

        "right": [
            {
                "builtin": "battery",
                "on-click": ["dot-menu", "power"],
                "config": {
                    "warning": 20,
                    "critical": 10,
                    "notify-critical": true,
                    "format": {
                        "discharging": "{icon}",
                        "charging": "{icon}",
                        "plugged": "",
                        "full": "󰂅"
                    },
                    "icons": {
                        "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
                        "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
                    }
                }
            },
            {
                "id": "column-indicator",
                "module": "niri-column-indicator",
                "kind": "text"
            }
        ]
    }
}
